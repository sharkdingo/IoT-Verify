    "@types/mdast": "4.0.4",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^26.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-types": "2.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.7.3",
    "unified": "11.0.5",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.2",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
