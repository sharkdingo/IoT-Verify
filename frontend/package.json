    "@fontsource/material-symbols-outlined": "^5.3.0",
    "@shikijs/langs": "^3.19.0",
    "axios": "^1.13.2",
    "element-plus": "^2.11.7",
    "katex": "^0.16.27",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "2.3.3",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.2",
    "remark-math": "^6.0.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-mdr": "^0.0.13",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
