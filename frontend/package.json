  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test:unit": "vitest",
    "test:changed": "vitest run --changed",
    "test:contracts": "vitest run src/styles/__tests__",
    "test:e2e": "node scripts/run-e2e.mjs smoke",
