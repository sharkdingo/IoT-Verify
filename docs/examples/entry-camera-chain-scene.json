        {
          "deviceId": "motion_sensor",
          "targetType": "variable",
          "key": "motion",
          "relation": "=",
          "value": "detected",
          "variableSource": "environment"
        }
      ],
      "thenConditions": [
        {
          "deviceId": "entry_light",
          "targetType": "mode",
