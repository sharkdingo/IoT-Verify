	"rules": [
		{
			"name": "Treat an abnormal reading during a night-time bed exit as an emergency",
			"sources": [
				{
					"fromId": "vitals",
					"fromApi": "heartRate",
					"itemType": "variable",
					"relation": ">",
					"value": "120"
				},
				{
					"fromId": "bed_sensor",
					"fromApi": "bedOccupancy",
					"itemType": "variable",
					"relation": "=",
					"value": "empty"
				},
				{
					"fromId": "clock",
					"fromApi": "time",
					"itemType": "variable",
					"relation": "in",
					"value": "22,23,0,1,2,3,4,5,6"
				}
			],
			"toId": "vitals",
			"toApi": "signal_anomaly"
